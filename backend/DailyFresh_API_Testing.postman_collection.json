	"item": [
		{
			"name": "1. Authentication & Global Profile",
			"item": [
				{ "name": "Register", "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"full_name\":\"Test\",\"email\":\"test@test.com\",\"phone\":\"123\",\"password\":\"pass\",\"role\":\"customer\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/register" } },
				{ "name": "Login", "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json(); if(res.data?.access_token) pm.collectionVariables.set('authToken', res.data.access_token);"], "type": "text/javascript" } }], "request": { "method": "POST", "body": { "mode": "raw", "raw": "{\"email\":\"test@test.com\",\"password\":\"pass\"}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login" } },
				{ "name": "Update Profile", "request": { "method": "PATCH", "url": "{{baseUrl}}/auth/profile" } },
				{ "name": "Update Password", "request": { "method": "PATCH", "url": "{{baseUrl}}/auth/password" } }
			]
		},
