# ==========================================
# DailyFresh Backend Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=production

# Database Connection (Direct PostgreSQL pooler)
DB_HOST=db.ckrtechnologies.in
DB_PORT=5432
DB_NAME=postgres
DB_USER=dailyfresh_user
DB_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://dailyfresh_user:your_db_password_here@db.ckrtechnologies.in:5432/postgres?sslmode=disable

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_generate_using_openssl_rand_hex_32

# Storage & Assets
UPLOAD_PATH=/var/www/dailyfresh/public/uploads
CDN_BASE_URL=https://api.dailyfreshkolkata.in

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Push Notifications (Firebase Service Account)
FIREBASE_PROJECT_ID=dailyfresh-xxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@dailyfresh-xxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
